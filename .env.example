# --- AI ------------------------------------------------------------------
# Gemini (free tier): https://aistudio.google.com/apikey, preferred when set.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
# Claude is also supported (paid). Without any key Landed runs in "demo AI" mode.
# LANDED_AI_PROVIDER=gemini|anthropic
ANTHROPIC_API_KEY=
# Only if your key is not scoped to a workspace (Console → Settings → Workspaces)
ANTHROPIC_WORKSPACE_ID=
# Optional override (defaults to claude-opus-5-5)
# LANDED_MODEL=claude-opus-5-5

# --- PayPal sandbox -------------------------------------------------------
# developer.paypal.com -> Apps & Credentials -> Sandbox -> your app
# Without credentials Landed runs in "simulated PayPal" mode.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Sandbox *personal* account email that receives supplier payouts
PAYPAL_SUPPLIER_EMAIL=

# --- App -----------------------------------------------------------------
PORT=8787
# Freeze the demo clock so the story is reproducible (YYYY-MM-DD). Leave empty for real today.
LANDED_TODAY=2026-10-23
